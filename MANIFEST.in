# Source distribution contents.
include README.md
include README.zh-CN.md
include LICENSE
include Cargo.toml
include Cargo.lock
include pyproject.toml
include MANIFEST.in
include dual6_cli.py
include run_tests.py

include docs/*.md
include docs/*.svg
include tools/*.py

recursive-include benchmarks *.csv *.md *.png
recursive-include python *.py *.pyi
recursive-include crates *.rs *.toml
recursive-include tests *.py *.json *.txt
recursive-include examples *.py

# Never ship build outputs or bytecode.
prune target
prune crates/dual6-py/target
global-exclude __pycache__ *.py[cod] *.pyd *.so *.dll
